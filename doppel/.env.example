# ── copy to .env.local and fill in ──────────────────────────────────────────

# LLM
ANTHROPIC_API_KEY=

# Sponsors
FIRECRAWL_API_KEY=
FAL_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=              # set after cloning your voice (~10:45)

# ── Instagram (the target platform) ─────────────────────────────────────────
# Needs an IG Business/Creator account linked to a Facebook Page.
# Graph API long-lived token with instagram_basic + instagram_content_publish.
IG_USER_ID=                       # numeric Instagram Business account ID
IG_ACCESS_TOKEN=

# ── Guaranteed-real publishing (the 20-min zero-risk proof) ─────────────────
BLUESKY_HANDLE=                   # e.g. doppeldemo.bsky.social
BLUESKY_APP_PASSWORD=             # App Password, NOT the account password
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL=                 # e.g. @doppeldemo

# n8n (nightly loop only — publishing goes direct from the app)
N8N_LOOP_WEBHOOK=
N8N_SECRET=

# Storage
BLOB_READ_WRITE_TOKEN=            # vercel env pull after linking Blob

# Rails
DOPPEL_PUBLISH_ENABLED=false      # flip true at 15:00
MAX_DROPS=25
NEXT_PUBLIC_APP_URL=http://localhost:3000
