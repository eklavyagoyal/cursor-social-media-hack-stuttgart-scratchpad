# ── Briefing (Claude) ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Transkription + Wort-Timestamps (ElevenLabs Scribe) ──────────────────────
ELEVENLABS_API_KEY=

# ── Optional: Account-Kontext einlesen, damit die Tonalität passt ────────────
FIRECRAWL_API_KEY=

# ── Instagram Business posting ───────────────────────────────────────────────
# IG_USER_ID ist die Instagram-Business-Account-ID, NICHT der @handle.
IG_USER_ID=
IG_ACCESS_TOKEN=
# graph.facebook.com bei Facebook-Login, graph.instagram.com bei Instagram-Login
IG_GRAPH_HOST=https://graph.facebook.com

# ── Telegram: der Beweis, der nie durch ein Review muss ──────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL=

# ── Öffentliche Video-URL ────────────────────────────────────────────────────
# Instagram lädt das Video selbst herunter, localhost geht also nicht.
# Entweder Vercel Blob ...
BLOB_READ_WRITE_TOKEN=
# ... oder ein Tunnel auf den Dev-Server, z.B. cloudflared.
PUBLIC_BASE_URL=

# ── Sicherheitsschalter ──────────────────────────────────────────────────────
# Auf false lassen, solange gebaut wird. Erst zum Schluss auf true.
PUBLISH_ENABLED=false
