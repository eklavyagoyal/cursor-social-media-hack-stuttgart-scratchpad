# ── Briefing + Marken-Analyse (OpenAI) ───────────────────────────────────────
OPENAI_API_KEY=
# Optional. Default gpt-5.6. Auf gpt-5.6-terra runterstellen, wenn Credits knapp
# werden — die Texte werden dann etwas blasser, laufen aber weiter.
OPENAI_MODEL=

# ── Transkription + Wort-Timestamps (ElevenLabs Scribe) ──────────────────────
ELEVENLABS_API_KEY=

# ── Optional: Account-Kontext einlesen, damit die Tonalität passt ────────────
FIRECRAWL_API_KEY=

# ── Instagram Business posting ───────────────────────────────────────────────
# IG_USER_ID ist die Instagram-Business-Account-ID, NICHT der @handle.
IG_USER_ID=
IG_ACCESS_TOKEN=
# graph.facebook.com bei Facebook-Login, graph.instagram.com bei Instagram-Login
IG_GRAPH_HOST=https://graph.facebook.com

# ── Telegram: der Beweis, der nie durch ein Review muss ──────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL=

# ── Öffentliche Video-URL ────────────────────────────────────────────────────
# Instagram lädt das Video selbst herunter, localhost geht also nicht.
# Entweder Vercel Blob ...
BLOB_READ_WRITE_TOKEN=
# ... oder ein Tunnel auf den Dev-Server, z.B. cloudflared.
PUBLIC_BASE_URL=

# ── Sicherheitsschalter ──────────────────────────────────────────────────────
# Auf false lassen, solange gebaut wird. Erst zum Schluss auf true.
PUBLISH_ENABLED=false

# Freigabe fuers Posten. Die App laeuft in der Demo oeffentlich, und die Caption
# kommt vom Client — ohne dieses Secret koennte jeder Besucher auf unseren echten
# Account posten. Leer = Posten ist gesperrt. Beliebige lange Zufallszeichenkette.
PUBLISH_SECRET=

# ── Platte / Scratch ─────────────────────────────────────────────────────────
# Ein 30s-Handyclip laesst 40-90 MB liegen (Roh-Upload + Audio + mp4). Auf einer
# kleinen Hetzner-Platte zaehlt das. Aelteres wird beim naechsten /api/process
# geloescht — nicht sofort, weil die UI rawUrl und den Render noch anzeigt und
# ohne Blob der Render selbst die oeffentliche URL fuer Instagram ist.
SWEEP_AFTER_MINUTES=30
# Roh-Upload-Limit. Ein Reel sind 20-40 Sekunden, also zweistellige MB.
MAX_UPLOAD_MB=250
